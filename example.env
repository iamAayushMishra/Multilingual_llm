# NCERT-Mitra Configuration Template
# Copy this file to '.env' and populate your key.

# --- API Keys ---
# Replace with your actual Gemini API Key
GOOGLE_API_KEY="YOUR_API_KEY_HERE"

# --- Models ---
# LLM Model name
GEMINI_MODEL_NAME="gemini-3.5-flash"
# Multilingual SentenceTransformer model for embeddings
EMBEDDING_MODEL_NAME="paraphrase-multilingual-MiniLM-L12-v2"
# Cross-Encoder model name for Reranking
CROSS_ENCODER_MODEL_NAME="BAAI/bge-reranker-base"

# --- Database & Storage Configuration ---
# Directory where textbook PDFs are stored
PDF_SOURCE_DIR="textbook_pdfs"
# Directory where ChromaDB indexes are saved
CHROMA_PERSIST_DIR="ncert_db"
# Name of the collection in ChromaDB
COLLECTION_NAME="ncert_books"
# Path to local SQLite semantic cache database
SEMANTIC_CACHE_DB_PATH="semantic_cache.db"

# --- RAG Parameter Configuration ---
# Max characters per document chunk
CHUNK_SIZE=1000
# Character overlap between adjacent chunks
CHUNK_OVERLAP=200
# Cosine similarity threshold for semantic query cache matching
SEMANTIC_CACHE_THRESHOLD=0.92

# --- Retrieval Pipeline Configuration ---
# Number of dense search vector candidates to retrieve
RETRIEVAL_DENSE_K=15
# Number of sparse search BM25 candidates to retrieve
RETRIEVAL_SPARSE_K=15
# Final top documents to feed into LLM after Reranking
RETRIEVAL_TOP_K=4
